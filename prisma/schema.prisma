generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ConsentType {
  TERMS_OF_USE
  PRIVACY_POLICY
  GARMIN_DATA
  WHATSAPP_MESSAGES
}

enum IntegrationStatus {
  DISCONNECTED
  CONNECTING
  CONNECTED
  ERROR
}

enum GarminSyncStatus {
  RUNNING
  SUCCESS
  ERROR
}

enum GarminMetricType {
  HRV
  SLEEP
  VO2_MAX
  ACTIVITY
  TRAINING_LOAD
}

model User {
  id                 Int                @id @default(autoincrement())
  uuid               String             @unique @default(cuid())
  email              String             @unique
  name               String?
  passwordHash       String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  profile            Profile?
  consents           Consent[]
  integrations       Integration[]
  readinessSnapshots ReadinessSnapshot[]
  garminConnections  GarminConnection[]
  garminSyncLogs     GarminSyncLog[]
  garminMetrics      GarminMetric[]
}

model Profile {
  id        Int      @id @default(autoincrement())
  uuid      String   @unique @default(cuid())
  userId    Int      @unique
  birthDate DateTime?
  timezone  String   @default("America/Sao_Paulo")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Consent {
  id         Int         @id @default(autoincrement())
  uuid       String      @unique @default(cuid())
  userId     Int
  type       ConsentType
  version    String
  accepted   Boolean     @default(false)
  acceptedAt DateTime?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime    @default(now())
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type, version])
}

model Integration {
  id           Int               @id @default(autoincrement())
  uuid         String            @unique @default(cuid())
  userId       Int
  provider     String
  status       IntegrationStatus @default(DISCONNECTED)
  externalId   String?
  accessToken  String?           // Store encrypted before enabling real providers.
  refreshToken String?           // Store encrypted before enabling real providers.
  connectedAt  DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
}

model ReadinessSnapshot {
  id        Int      @id @default(autoincrement())
  uuid      String   @unique @default(cuid())
  userId    Int
  score     Int
  summary   String?
  source    String   @default("stub")
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model GarminConnection {
  id                    Int               @id @default(autoincrement())
  uuid                  String            @unique @default(cuid())
  userId                Int
  provider              String            @default("garmin")
  status                IntegrationStatus @default(DISCONNECTED)
  externalUserId        String?
  accessTokenEncrypted  String?
  refreshTokenEncrypted String?
  tokenExpiresAt        DateTime?
  scopes                String[]          @default([])
  connectedAt           DateTime?
  lastSyncAt            DateTime?
  lastError             String?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  user                  User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  syncLogs              GarminSyncLog[]
  metrics               GarminMetric[]

  @@unique([userId, provider])
  @@index([status])
}

model GarminSyncLog {
  id               Int              @id @default(autoincrement())
  uuid             String           @unique @default(cuid())
  userId           Int
  connectionId     Int
  status           GarminSyncStatus @default(RUNNING)
  startedAt        DateTime         @default(now())
  finishedAt       DateTime?
  from             DateTime?
  to               DateTime?
  metricsRequested String[]         @default([])
  recordsImported  Int              @default(0)
  errorMessage     String?
  createdAt        DateTime         @default(now())
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  connection       GarminConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([userId, startedAt])
  @@index([connectionId, startedAt])
  @@index([status])
}

model GarminMetric {
  id           Int              @id @default(autoincrement())
  uuid         String           @unique @default(cuid())
  userId       Int
  connectionId Int
  type         GarminMetricType
  sourceId     String?
  measuredAt   DateTime
  startAt      DateTime?
  endAt        DateTime?
  value        Float?
  unit         String?
  summary      Json?
  raw          Json?
  createdAt    DateTime         @default(now())
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  connection   GarminConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, type, sourceId, measuredAt])
  @@index([userId, type, measuredAt])
  @@index([connectionId, measuredAt])
}
