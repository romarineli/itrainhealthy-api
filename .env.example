NODE_ENV=development
PORT=3000
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/itrainhealthy?schema=public"
# Public frontend and backend origins. In production, API_URL should match the URL registered in Garmin.
APP_URL="http://localhost:5173"
FRONTEND_URL="http://localhost:5173"
API_URL="http://localhost:3000"
CORS_ORIGIN="http://localhost:5173"

# Auth/JWT placeholders (do not commit real secrets)
# Required before production. Example generator: openssl rand -base64 32
JWT_SECRET=""
JWT_EXPIRES_IN_SECONDS=604800

# Garmin OAuth placeholders (do not commit real credentials)
GARMIN_CLIENT_ID=""
GARMIN_CLIENT_SECRET=""
# Must exactly match the redirect URL registered in Garmin. Defaults to API_URL + /api/garmin/callback when omitted.
GARMIN_REDIRECT_URI="http://localhost:3000/api/garmin/callback"
# Garmin Connect Developer Program OAuth 2.0 PKCE endpoints.
# Do not use https://apis.garmin.com/oauth/authorize; that host is for Wellness REST APIs and returns ApplicationNotFound for OAuth authorize.
GARMIN_AUTHORIZATION_URL="https://connect.garmin.com/oauth2Confirm"
GARMIN_TOKEN_URL="https://connectapi.garmin.com/di-oauth2-service/oauth/token"
GARMIN_API_BASE_URL="https://apis.garmin.com"
# Browser redirects after backend callback exchanges code for tokens. Garmin redirect URI remains the backend callback.
# Defaults to FRONTEND_URL + /integrations/garmin/success|error when omitted.
GARMIN_SUCCESS_REDIRECT_URL="http://localhost:5173/integrations/garmin/success"
GARMIN_ERROR_REDIRECT_URL="http://localhost:5173/integrations/garmin/error"
# Internal application secrets, not provided by Garmin.
# Generate in our infra/app as strong random strings before production.
# Example generator: openssl rand -base64 32
GARMIN_STATE_SECRET=""
GARMIN_TOKEN_ENCRYPTION_KEY=""

# WhatsApp provider placeholders (not implemented in MVP scaffold)
WHATSAPP_PROVIDER="stub"
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
